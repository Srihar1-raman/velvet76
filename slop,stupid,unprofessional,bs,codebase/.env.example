# Google Maps JavaScript API key (browser-restricted by HTTP referrer in GCP).
# Do NOT commit a real key. Copy this file to `.env.local` and set the key there.
# In GCP Console → Credentials → restrict by:
#   - HTTP referrers: yourdomain.com/*, www.yourdomain.com/*
#   - APIs: Maps JavaScript API, Places API only
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# When set to "1" the UI shows the mock OTP (123456) hint copy. Leave unset in
# production so demo OTP details never render in user-facing strings.
NEXT_PUBLIC_DEV_MODE=""
